{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "triggers": {
    "Recurrence": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "GMT Standard Time",
        "schedule": {
          "hours": [7, 19, 20],
          "minutes": [0]
        }
      },
      "description": "Runs daily at 07:00, 19:00 and 20:00 UK time (GMT Standard Time)"
    }
  },
  "actions": {
    "Local_time": {
      "type": "Compose",
      "inputs": "@convertFromUtc(utcNow(), 'GMT Standard Time')",
      "runAfter": {},
      "description": "Current UK local time"
    },
    "Switch_on_run_hour": {
      "type": "Switch",
      "expression": "@formatDateTime(outputs('Local_time'), 'HH')",
      "cases": {
        "Resume_07": {
          "case": "07",
          "actions": {
            "Is_weekday_for_resume": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greaterOrEquals": [
                      "@dayOfWeek(outputs('Local_time'))",
                      1
                    ]
                  },
                  {
                    "lessOrEquals": [
                      "@dayOfWeek(outputs('Local_time'))",
                      5
                    ]
                  }
                ]
              },
              "actions": {
                "Foreach_capacity_resume": {
                  "type": "Foreach",
                  "foreach": "@parameters('CapacityNamesParam')",
                  "actions": {
                    "Resume_PBI_Embedded": {
                      "type": "Http",
                      "inputs": {
                        "uri": "@concat('https://management.azure.com/subscriptions/', parameters('SubscriptionIdParam'), '/resourceGroups/', parameters('ResourceGroupNameParam'), '/providers/Microsoft.PowerBIDedicated/capacities/', item(), '/resume?api-version=2017-10-01')",
                        "method": "POST",
                        "authentication": {
                          "type": "ActiveDirectoryOAuth",
                          "authority": "",
                          "tenant": "@parameters('TenantIdParam')",
                          "audience": "https://management.core.windows.net/",
                          "clientId": "@parameters('ClientIdParam')",
                          "credentialType": "Secret",
                          "secret": "@parameters('ClientSecretParam')"
                        }
                      },
                      "runtimeConfiguration": {
                        "secureData": {
                          "properties": ["inputs"]
                        }
                      },
                      "runAfter": {},
                      "description": "Resume the Power BI Embedded capacity (weekdays 07:00 UK time)."
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {}
            }
          }
        },
        "Scale_down_19": {
          "case": "19",
          "actions": {
            "Foreach_capacity_scale_down": {
              "type": "Foreach",
              "foreach": "@parameters('CapacityNamesParam')",
              "actions": {
                "Scale_down_PBI_Embedded": {
                  "type": "Http",
                  "inputs": {
                    "uri": "@concat('https://management.azure.com/subscriptions/', parameters('SubscriptionIdParam'), '/resourceGroups/', parameters('ResourceGroupNameParam'), '/providers/Microsoft.PowerBIDedicated/capacities/', item(), '?api-version=2017-10-01')",
                    "method": "PATCH",
                    "body": {
                      "sku": {
                        "name": "@parameters('scaleDownSkuNameParam')",
                        "tier": "@parameters('scaleDownSkuTierParam')"
                      }
                    },
                    "authentication": {
                      "type": "ActiveDirectoryOAuth",
                      "authority": "",
                      "tenant": "@parameters('TenantIdParam')",
                      "audience": "https://management.core.windows.net/",
                      "clientId": "@parameters('ClientIdParam')",
                      "credentialType": "Secret",
                      "secret": "@parameters('ClientSecretParam')"
                    }
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": ["inputs"]
                    }
                  },
                  "runAfter": {},
                  "description": "Scale the Power BI Embedded capacity down daily at 19:00 UK time."
                }
              },
              "runAfter": {}
            }
          }
        },
        "Pause_20": {
          "case": "20",
          "actions": {
            "Foreach_capacity_pause": {
              "type": "Foreach",
              "foreach": "@parameters('CapacityNamesParam')",
              "actions": {
                "Pause_PBI_Embedded": {
                  "type": "Http",
                  "inputs": {
                    "uri": "@concat('https://management.azure.com/subscriptions/', parameters('SubscriptionIdParam'), '/resourceGroups/', parameters('ResourceGroupNameParam'), '/providers/Microsoft.PowerBIDedicated/capacities/', item(), '/suspend?api-version=2017-10-01')",
                    "method": "POST",
                    "authentication": {
                      "type": "ActiveDirectoryOAuth",
                      "authority": "",
                      "tenant": "@parameters('TenantIdParam')",
                      "audience": "https://management.core.windows.net/",
                      "clientId": "@parameters('ClientIdParam')",
                      "credentialType": "Secret",
                      "secret": "@parameters('ClientSecretParam')"
                    }
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": ["inputs"]
                    }
                  },
                  "runAfter": {},
                  "description": "Pause (suspend) the Power BI Embedded capacity daily at 20:00 UK time."
                }
              },
              "runAfter": {}
            }
          }
        }
      },
      "default": {
        "actions": {}
      },
      "runAfter": {
        "Local_time": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {},
  "parameters": {
    "SubscriptionIdParam": {
      "type": "String"
    },
    "ResourceGroupNameParam": {
      "type": "String"
    },
    "CapacityNamesParam": {
      "type": "Array"
    },
    "TenantIdParam": {
      "type": "String"
    },
    "ClientIdParam": {
      "type": "String"
    },
    "ClientSecretParam": {
      "type": "securestring"
    },
    "scaleDownSkuNameParam": {
      "type": "String",
      "defaultValue": "A1"
    },
    "scaleDownSkuTierParam": {
      "type": "String",
      "defaultValue": "PBIE_Azure"
    }
  }
}
